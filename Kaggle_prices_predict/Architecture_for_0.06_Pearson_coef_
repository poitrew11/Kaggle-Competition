def residual_block(x, units, dropout_rate, alpha=0.01):
    y = Dense(units)(x)
    y = BatchNormalization()(y)
    y = LeakyReLU(alpha=alpha)(y)
    y = Dropout(dropout_rate)(y)
    if x.shape[-1] != units:
        x = Dense(units)(x)
        x = BatchNormalization()(x)
    
    out = Add()([x, y])
    out = LeakyReLU(alpha=alpha)(out)
    return out

